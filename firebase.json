{
  "hosting": {
    "site": "aue",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/comunidades", "destination": "/", "type": 301 },
      { "source": "/comunidades/", "destination": "/", "type": 301 },
      { "source": "/comunidade", "destination": "/", "type": 301 },
      { "source": "/comunidade/", "destination": "/", "type": 301 },
      { "regex": "^/comunidade/[^/]+/?$", "destination": "/", "type": 301 },
      { "regex": "^/comunidades/[^/]+/?$", "destination": "/", "type": 301 },
      { "source": "/bondes", "destination": "/", "type": 301 },
      { "source": "/bondes/", "destination": "/", "type": 301 },
      { "source": "/comm", "destination": "/", "type": 301 },
      { "source": "/comm/", "destination": "/", "type": 301 },
      { "source": "/explorar", "destination": "/", "type": 301 },
      { "source": "/explorar/", "destination": "/", "type": 301 },
      { "regex": "^/c/[^/]+/?$", "destination": "/", "type": 301 },
      { "regex": "^/c/[^/]+/novo/?$", "destination": "/", "type": 301 },
      { "regex": "^/c/[^/]+/t/[^/]+/?$", "destination": "/", "type": 301 },
      { "regex": "^/topico/[^/]+/?$", "destination": "/", "type": 301 },
      { "regex": "^/t/[^/]+/?$", "destination": "/", "type": 301 },
      { "source": "/videos-de-arroto", "destination": "/", "type": 301 },
      { "source": "/videos-de-arroto/", "destination": "/", "type": 301 },
      { "source": "/videos", "destination": "/", "type": 301 },
      { "source": "/videos/", "destination": "/", "type": 301 }
    ],
    "rewrites": [
      { "source": "/privacidade", "destination": "/privacidade.html" },
      { "source": "/privacidade/", "destination": "/privacidade.html" },
      { "source": "/termos", "destination": "/termos.html" },
      { "source": "/termos/", "destination": "/termos.html" },
      { "source": "/en", "destination": "/en.html" },
      { "source": "/en/", "destination": "/en.html" },
      { "source": "/como-jogar", "destination": "/como-jogar.html" },
      { "source": "/como-jogar/", "destination": "/como-jogar.html" },
      { "source": "/como-arrotar", "destination": "/como-arrotar.html" },
      { "source": "/como-arrotar/", "destination": "/como-arrotar.html" },
      { "source": "/tipos-de-arroto", "destination": "/tipos-de-arroto.html" },
      { "source": "/tipos-de-arroto/", "destination": "/tipos-de-arroto.html" },
      { "source": "/ranking-de-arrotos", "destination": "/ranking-de-arrotos.html" },
      { "source": "/ranking-de-arrotos/", "destination": "/ranking-de-arrotos.html" },
      { "source": "/grupos", "destination": "/grupos.html" },
      { "source": "/grupos/", "destination": "/grupos.html" },
      { "source": "/duelo", "destination": "/duelo.html" },
      { "source": "/duelo/", "destination": "/duelo.html" },
      { "source": "/feed", "destination": "/index.html" },
      { "source": "/feed/", "destination": "/index.html" },
      { "source": "/em-alta", "destination": "/index.html" },
      { "source": "/em-alta/", "destination": "/index.html" },
      { "source": "/seguindo", "destination": "/index.html" },
      { "source": "/seguindo/", "destination": "/index.html" },
      { "source": "/arena", "destination": "/index.html" },
      { "source": "/arena/", "destination": "/index.html" },
      { "source": "/arena/em-breve", "destination": "/index.html" },
      { "source": "/arena/em-breve/", "destination": "/index.html" },
      { "source": "/desafios", "destination": "/index.html" },
      { "source": "/desafios/", "destination": "/index.html" },
      { "source": "/perfil", "destination": "/index.html" },
      { "source": "/perfil/", "destination": "/index.html" },
      { "source": "/login", "destination": "/index.html" },
      { "source": "/login/", "destination": "/index.html" },
      { "source": "/entrar", "destination": "/index.html" },
      { "source": "/entrar/", "destination": "/index.html" },
      { "source": "/redefinir-senha", "destination": "/index.html" },
      { "source": "/redefinir-senha/", "destination": "/index.html" },
      { "source": "/admin", "destination": "/index.html" },
      { "source": "/admin/", "destination": "/index.html" },
      { "source": "/ranking", "destination": "/index.html" },
      { "source": "/ranking/", "destination": "/index.html" },
      { "source": "/landing", "destination": "/index.html" },
      { "source": "/landing/", "destination": "/index.html" },
      { "source": "/versoes", "destination": "/index.html" },
      { "source": "/versoes/", "destination": "/index.html" },
      { "source": "/mobile", "destination": "/index.html" },
      { "source": "/mobile/", "destination": "/index.html" },
      { "source": "/versao-mobile", "destination": "/index.html" },
      { "source": "/versao-mobile/", "destination": "/index.html" },
      { "regex": "^/x1/[^/]+/?$", "destination": "/index.html" },
      { "regex": "^/b/[^/]+/?$", "destination": "/index.html" },
      { "regex": "^/d/[^/]+/?$", "destination": "/index.html" },
      { "regex": "^/u/[^/]+/?$", "destination": "/index.html" },
      { "regex": "^/perfil/[^/]+/?$", "destination": "/index.html" },
      { "regex": "^/resenha/[^/]+/?$", "destination": "/index.html" },
      { "regex": "^/historia/[^/]+/?$", "destination": "/index.html" },
      { "regex": "^/conto/[^/]+/?$", "destination": "/index.html" },
      { "regex": "^/g/[^/]+/?$", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/feed",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/perfil{,/**}",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/u/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/c/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/duelo",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/duelo/",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/duelo.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/b/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/d/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/x1/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      }
    ]
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "installCommand": "true",
  "buildCommand": "rm -rf dist && mkdir -p dist && cp scripts/sw-legado-migracao.js dist/sw.js",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://arrotaaue.com.br/",
      "statusCode": 301
    },
    {
      "source": "/:path((?!sw\\.js$).*)",
      "destination": "https://arrotaaue.com.br/:path*",
      "statusCode": 301
    }
  ]
}

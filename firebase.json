{
  "hosting": {
    "site": "aue",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/comunidade", "destination": "/comunidades", "type": 301 }
    ],
    "rewrites": [
      { "source": "/privacidade", "destination": "/privacidade.html" },
      { "source": "/termos", "destination": "/termos.html" },
      { "source": "/como-jogar", "destination": "/como-jogar.html" },
      { "source": "/como-arrotar", "destination": "/como-arrotar.html" },
      { "source": "/tipos-de-arroto", "destination": "/tipos-de-arroto.html" },
      { "source": "/ranking-de-arrotos", "destination": "/ranking-de-arrotos.html" },
      { "source": "/comunidades", "destination": "/comunidades.html" },
      { "source": "/grupos", "destination": "/grupos.html" },
      { "source": "/videos-de-arroto", "destination": "/videos-de-arroto.html" },
      { "source": "/videos", "destination": "/videos-de-arroto.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/c/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}

{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/bolha/**",
              "components/botao/**",
              "components/cronometro/**",
              "components/gatilho/**",
              "components/hud/**",
              "components/metrica/**",
              "components/nota/**",
              "components/origem/**",
              "components/overlay/**",
              "components/pilulas/**",
              "components/placar/**",
              "components/podio/**",
              "ui_kits/arena/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|Archivo|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Anton, Archivo, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlocoVersus'] > JSXAttribute > JSXIdentifier[name!=/^(?:esquerda|direita|empate|key|ref|className|style|children)$/]",
        "message": "<BlocoVersus> doesn't accept that prop. Declared props: esquerda, direita, empate."
      },
      {
        "selector": "JSXOpeningElement[name.name='BolhaAue'] > JSXAttribute > JSXIdentifier[name!=/^(?:modo|nivel|size|reducedMotion|key|ref|className|style|children)$/]",
        "message": "<BolhaAue> doesn't accept that prop. Declared props: modo, nivel, size, reducedMotion."
      },
      {
        "selector": "JSXOpeningElement[name.name='BolhaAue'] > JSXAttribute[name.name='modo'] > Literal[value!=/^(?:idle|asking|recording|holding|checking|judging|cradle|waiting|playing|flat|dead|victory|defeat)$/]",
        "message": "<BolhaAue> modo must be one of 'idle' | 'asking' | 'recording' | 'holding' | 'checking' | 'judging' | 'cradle' | 'waiting' | 'playing' | 'flat' | 'dead' | 'victory' | 'defeat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Botao'] > JSXAttribute > JSXIdentifier[name!=/^(?:variante|tamanho|disabled|onClick|type|children|key|ref|className|style|children)$/]",
        "message": "<Botao> doesn't accept that prop. Declared props: variante, tamanho, disabled, onClick, type, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Botao'] > JSXAttribute[name.name='variante'] > Literal[value!=/^(?:primario|contorno|fantasma)$/]",
        "message": "<Botao> variante must be one of 'primario' | 'contorno' | 'fantasma'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Botao'] > JSXAttribute[name.name='tamanho'] > Literal[value!=/^(?:grande|compacto)$/]",
        "message": "<Botao> tamanho must be one of 'grande' | 'compacto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Botao'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Botao> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cronometro'] > JSXAttribute > JSXIdentifier[name!=/^(?:segundos|maximo|key|ref|className|style|children)$/]",
        "message": "<Cronometro> doesn't accept that prop. Declared props: segundos, maximo."
      },
      {
        "selector": "JSXOpeningElement[name.name='EscolhaDeOrigem'] > JSXAttribute > JSXIdentifier[name!=/^(?:onEscolher|escolhida|key|ref|className|style|children)$/]",
        "message": "<EscolhaDeOrigem> doesn't accept that prop. Declared props: onEscolher, escolhida."
      },
      {
        "selector": "JSXOpeningElement[name.name='GatilhoDeMicrofone'] > JSXAttribute > JSXIdentifier[name!=/^(?:jaGravou|permissao|onClick|size|key|ref|className|style|children)$/]",
        "message": "<GatilhoDeMicrofone> doesn't accept that prop. Declared props: jaGravou, permissao, onClick, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='GatilhoDeMicrofone'] > JSXAttribute[name.name='permissao'] > Literal[value!=/^(?:concedida|pedindo|negada)$/]",
        "message": "<GatilhoDeMicrofone> permissao must be one of 'concedida' | 'pedindo' | 'negada'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hud'] > JSXAttribute > JSXIdentifier[name!=/^(?:x1Aberto|onMenu|oculto|key|ref|className|style|children)$/]",
        "message": "<Hud> doesn't accept that prop. Declared props: x1Aberto, onMenu, oculto."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinhaDoPlacar'] > JSXAttribute > JSXIdentifier[name!=/^(?:nome|nota|lider|tocando|semAudio|onPlay|key|ref|className|style|children)$/]",
        "message": "<LinhaDoPlacar> doesn't accept that prop. Declared props: nome, nota, lider, tocando, semAudio, onPlay."
      },
      {
        "selector": "JSXOpeningElement[name.name='Metrica'] > JSXAttribute > JSXIdentifier[name!=/^(?:rotulo|valor|percentual|key|ref|className|style|children)$/]",
        "message": "<Metrica> doesn't accept that prop. Declared props: rotulo, valor, percentual."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotaNaBolha'] > JSXAttribute > JSXIdentifier[name!=/^(?:impacto|valor|rotulo|tamanho|key|ref|className|style|children)$/]",
        "message": "<NotaNaBolha> doesn't accept that prop. Declared props: impacto, valor, rotulo, tamanho."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotaNaBolha'] > JSXAttribute[name.name='tamanho'] > Literal[value!=/^(?:revelacao|resultado|x1)$/]",
        "message": "<NotaNaBolha> tamanho must be one of 'revelacao' | 'resultado' | 'x1'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Overlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:titulo|onFechar|children|key|ref|className|style|children)$/]",
        "message": "<Overlay> doesn't accept that prop. Declared props: titulo, onFechar, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PilulaDeLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:link|onCopiar|key|ref|className|style|children)$/]",
        "message": "<PilulaDeLink> doesn't accept that prop. Declared props: link, onCopiar."
      },
      {
        "selector": "JSXOpeningElement[name.name='Player'] > JSXAttribute > JSXIdentifier[name!=/^(?:rotulo|duracao|progresso|tocando|onTogglePlay|key|ref|className|style|children)$/]",
        "message": "<Player> doesn't accept that prop. Declared props: rotulo, duracao, progresso, tocando, onTogglePlay."
      },
      {
        "selector": "JSXOpeningElement[name.name='Colocacao'] > JSXAttribute > JSXIdentifier[name!=/^(?:nome|nota|posicao|key|ref|className|style|children)$/]",
        "message": "<Colocacao> doesn't accept that prop. Declared props: nome, nota, posicao."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
